{
    "manifest_version": 3,
    "name": "PiTEX",
    "version": "1.3",
    "description": "AI Math Equation Copier - Extract LaTeX from LLMs/chatbots",
    "icons": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "permissions": [
      "clipboardWrite",
      "storage"
    ],
    "action": {
       "default_popup": "src/html/popup.html"
    },
    "content_scripts": [
      {
        "matches": [
          "*://chatgpt.com/*",
          "*://chat.deepseek.com/*",
          "*://apps.abacus.ai/*"
        ],
        "js": ["src/js/content.js"],
        "css": ["src/css/styles.css"]
      }
    ]
  }
